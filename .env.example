# UniHAP Environment Configuration

# LLM Providers
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Web Discovery & Scraping
FIRECRAWL_API_KEY=fc_your_firecrawl_api_key_here
WIKIDATA_USER_AGENT=UniHAP-CatalogBot/1.0 (contact@unihap.local)

# Knowledge Graph (Optional Neo4j, defaults to NetworkX)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Pipeline Configuration
UNIHAP_ENV=development
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD_AUTO_APPROVE=0.90
CONFIDENCE_THRESHOLD_NEEDS_REVIEW=0.70
